# Copie para .env (ou cole no Docker Manager do hPanel). NUNCA faça commit do .env.

# Supabase (projeto WebAgent) → Settings → API Keys
SUPABASE_URL=https://rgbwengbshwtxjlctpip.supabase.co
# Chave secreta (sb_secret_...). Dá acesso total ao banco: só no servidor.
SUPABASE_SERVICE_ROLE_KEY=

# Gere cada um com: openssl rand -hex 32
EVOLUTION_API_KEY=
EVOLUTION_DB_PASSWORD=
WEBHOOK_SECRET=

# Ping de manutenção do Supabase (horas). 24 = uma vez por dia.
HEARTBEAT_INTERVAL_HOURS=24
# Intervalo mínimo entre mensagens enviadas (ms)
SEND_MIN_INTERVAL_MS=1200
# Versão das imagens (latest ou o SHA do commit)
WEBAGENT_TAG=latest
